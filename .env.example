# Skopiuj do .env i wypełnij realnymi wartościami.
# Plik .env jest w .gitignore — nie commituj.

# ── Środowisko ───────────────────────────────────────
NODE_ENV=development
PORT=4000

# ── Baza danych (PostgreSQL) ─────────────────────────
# W docker-compose: DB_HOST=postgres (nazwa serwisu).
# W produkcji: managed Postgres host.
DB_HOST=postgres
DB_PORT=5432
DB_USER=moodflow
DB_PASSWORD=zmien_na_silne_haslo
DB_NAME=moodflow

# ── JWT (silne losowe sekrety, min. 32 znaki) ────────
# Wygeneruj: node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
# Sekrety MUSZĄ być różne (fail-fast walidacja w main.ts).
JWT_SECRET=zmien_na_silny_sekret_min_32_znaki
JWT_REFRESH_SECRET=zmien_na_inny_silny_sekret_min_32_znaki

# ── CORS ─────────────────────────────────────────────
# Lista publicznych URL frontendów oddzielona przecinkami.
CORS_ORIGIN=http://localhost:3000,http://localhost:3001

# ── URL-e frontendów ─────────────────────────────────
# Client (pracownik)
VITE_API_URL=http://localhost:4000
VITE_ADMIN_URL=http://localhost:3001
VITE_CLIENT_URL=http://localhost:3000

# Admin (HR/Admin/Super-admin)
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_CLIENT_URL=http://localhost:3000

# ── SMTP — powiadomienia email (Gmail) ───────────────
# Wymagane: 2FA na koncie Google + App Password
# https://myaccount.google.com/apppasswords
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USER=twoj_email@gmail.com
MAIL_PASS=app_password_z_google
